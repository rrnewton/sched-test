/$1 == 0 || pid == $1/
{
    $ts = nsecs; $c = cpu;
    printf("{\"ts_ns\":%llu,\"cpu\":%d,\"pid\":%d,\"kind\":\"%s\",\"name\":\"%s\",\"phase\":\"%s\",\"args\":{\"task_pid\":%d,\"dsq_id\":%llu,\"slice\":%llu,\"vtime\":%llu,\"enq_flags\":%llu},\"ret\":null}\n", $ts, $c, pid, "helper", "dsq_insert_vtime", "entry", args.p->pid, args.dsq_id, args.slice, args.vtime, args.enq_flags);
}

