#!/usr/bin/env bpftrace
/*
 * enqueue_dispatch_tracer.bt — Trace LAVD enqueue/dispatch for specific tasks
 *
 * Hooks the kernel-side enqueue path (do_enqueue_task) and the DSQ insert
 * kprobes (scx_bpf_dsq_insert / scx_bpf_dsq_insert_vtime) to trace the
 * complete lifecycle of a task from wakeup → enqueue → DSQ insert → dispatch.
 *
 * Only traces tasks matching the target comm (default: squashfuse_ll).
 *
 * Usage:
 *   sudo bpftrace enqueue_dispatch_tracer.bt
 *   # Or for a different target:
 *   sudo TARGET="myprocess" bpftrace enqueue_dispatch_tracer.bt
 *
 * Output: Per-event lines with timestamp, task info, and scheduling state.
 *
 * WARNING: This has higher overhead than watchdog_stall_probe.bt because
 *          it hooks hot-path functions.  Use only for targeted debugging.
 */

BEGIN
{
    printf("=== LAVD Enqueue/Dispatch Tracer ===\n");
    printf("Tracing squashfuse_ll task lifecycle...\n");
    printf("Fields: ts_us | event | pid | comm | details\n\n");
}

/*
 * do_enqueue_task — kernel calls this to hand a task to the BPF scheduler.
 * arg0 = rq, arg1 = task_struct, arg2 = enq_flags
 *
 * This is the ENTRY point into BPF scheduling.  If this fires but
 * scx_bpf_dsq_insert_vtime never fires for the same PID, the task
 * was lost between the kernel and BPF.
 */
kprobe:do_enqueue_task
{
    $p = (struct task_struct *)arg1;
    $comm_str = $p->comm;

    if ($comm_str == "squashfuse_ll" || $comm_str == "squashfuse") {
        $flags = arg2;
        $scx_flags = $p->scx.flags;
        $ops_state = $p->scx.ops_state.counter;
        $vtime = $p->scx.dsq_vtime;
        $runnable_at = $p->scx.runnable_at;

        printf("%llu | ENQ_KERN | %d | %s | enq_flags=0x%llx scx_flags=0x%x ops_state=%lld vtime=%llu runnable_at=%llu cpu=%d\n",
               nsecs / 1000,
               $p->pid, $comm_str,
               $flags, $scx_flags, $ops_state, $vtime, $runnable_at, cpu);

        @enqueue_time[$p->pid] = nsecs;
        @enqueue_count[$p->pid] = @enqueue_count[$p->pid] + 1;
    }
}

/*
 * scx_bpf_dsq_insert_vtime — the BPF scheduler calls this to place
 * a task on a DSQ with vtime ordering.  This is the SUCCESS path.
 *
 * arg0 = task_struct, arg1 = dsq_id, arg2 = slice, arg3 = vtime
 */
kprobe:scx_bpf_dsq_insert_vtime
{
    $p = (struct task_struct *)arg0;
    $comm_str = $p->comm;

    if ($comm_str == "squashfuse_ll" || $comm_str == "squashfuse") {
        $dsq_id = arg1;
        $slice = arg2;
        $vtime = arg3;
        $enq_ns = @enqueue_time[$p->pid];
        $delay_us = $enq_ns > 0 ? (nsecs - $enq_ns) / 1000 : 0;

        printf("%llu | DSQ_INS  | %d | %s | dsq_id=0x%llx vtime=%llu slice=%llu enq_to_dsq_us=%llu cpu=%d\n",
               nsecs / 1000,
               $p->pid, $comm_str,
               $dsq_id, $vtime, $slice, $delay_us, cpu);

        @insert_count[$p->pid] = @insert_count[$p->pid] + 1;
        delete(@enqueue_time[$p->pid]);
    }
}

/*
 * scx_bpf_dsq_insert — non-vtime DSQ insert (used for direct dispatch
 * to SCX_DSQ_LOCAL in lavd_select_cpu).
 */
kprobe:scx_bpf_dsq_insert
{
    $p = (struct task_struct *)arg0;
    $comm_str = $p->comm;

    if ($comm_str == "squashfuse_ll" || $comm_str == "squashfuse") {
        $dsq_id = arg1;
        $slice = arg2;

        printf("%llu | DSQ_DIR  | %d | %s | dsq_id=0x%llx slice=%llu (direct dispatch) cpu=%d\n",
               nsecs / 1000,
               $p->pid, $comm_str,
               $dsq_id, $slice, cpu);

        @insert_count[$p->pid] = @insert_count[$p->pid] + 1;
        delete(@enqueue_time[$p->pid]);
    }
}

/*
 * Track when the task actually starts running.
 */
tracepoint:sched:sched_switch
/args.next_comm == "squashfuse_ll" || args.next_comm == "squashfuse"/
{
    printf("%llu | RUNNING  | %d | %s | cpu=%d prev=%s[%d]\n",
           nsecs / 1000,
           args.next_pid, args.next_comm,
           cpu, args.prev_comm, args.prev_pid);
}

/*
 * Track when the task stops running.
 */
tracepoint:sched:sched_switch
/args.prev_comm == "squashfuse_ll" || args.prev_comm == "squashfuse"/
{
    printf("%llu | STOPPED  | %d | %s | cpu=%d state=%lld next=%s[%d]\n",
           nsecs / 1000,
           args.prev_pid, args.prev_comm,
           cpu, args.prev_state, args.next_comm, args.next_pid);
}

/*
 * Periodic stats dump.
 */
interval:s:10
{
    printf("\n--- [%llu] Stats ---\n", nsecs / 1000);
    print(@enqueue_count);
    print(@insert_count);
    printf("Pending enqueues (no DSQ insert yet):\n");
    print(@enqueue_time);
    printf("---\n\n");
}

END
{
    printf("\n=== Final Stats ===\n");
    printf("Enqueue counts per PID:\n");
    print(@enqueue_count);
    printf("DSQ insert counts per PID:\n");
    print(@insert_count);
    printf("Orphaned enqueues (enqueued but never inserted to DSQ):\n");
    print(@enqueue_time);
    clear(@enqueue_time);
    clear(@enqueue_count);
    clear(@insert_count);
}
