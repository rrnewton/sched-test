trace.proto
trace.proto
wprof.data
bpf_trace.log
.vscode-ctags
bug_finding/output/
__pycache__/
third_party/
csrc/e9_rbc_trampoline

# Allow Claude agent definitions to be tracked
!.claude/
!.claude/agents/
!.claude/agents/**

# Allow VSCode debug configuration to be tracked
!.vscode/
!.vscode/launch.json

# Coverage build artifacts (not tracked; regenerated by coverage.sh)
coverage-out/

# Allow coverage CSV history to be tracked
!data/
!data/coverage.csv
# Rust library-coverage ratchet baseline (committed; raise-only). No always-on
# history CSV — the ratchet measures + prints each run to avoid commit churn.
!data/rust_coverage_baseline.csv

# Benchmark HTML dashboards and logs (generated, not tracked)
data/benchmarks/*/*.html
data/benchmarks/*/benchmark_log_*.log
benchmark_results.html
benchmark_results.csv

# Python venv (created locally, not tracked)
.venv/

# Debug output (sweep results, ad-hoc investigation, etc.)
debug/

# Only ever built as a path dependency of the workspace (which owns the
# real lockfile); this crate is workspace-excluded, so any `cargo` command run
# from inside its directory drops a stray lock here and dirties the tree.
crates/scx_layered_growth/Cargo.lock
